PORT=5001

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=sua_senha_do_postgres
DATABASE=BackendProjetosERP
# Ou, no lugar das variáveis acima:
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco

ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@konvexjr.com.br"
ADMIN_PASSWORD="defina_uma_senha_forte"

# Origens do frontend autorizadas (CORS), separadas por vírgula.
CORS_ORIGINS=http://localhost:5173

# Opcional para containers; use os conteúdos PEM com quebras de linha escapadas.
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
# JWT_ACCESS_TTL=15m
# REFRESH_TOKEN_DIAS=7

SWAGGER_SERVER_URL=http://localhost:5001
